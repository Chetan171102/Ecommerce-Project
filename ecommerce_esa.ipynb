   "source": [
    "## 3. Cleaning Validation",
    "Re-verifying Phase 1's claim that the dataset was already clean \u2014 done independently here rather than assumed."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [
    {
     "output_type": "stream",
     "name": "stdout",
     "text": [
      "Missing values per column:\n",
      "None \u2014 0 missing values across all columns.\n",
      "\n",
      "Fully duplicated rows: 0\n",
      "Duplicated order_id values: 0\n"
     ]
    }
   ],
   "source": [
    "print(\"Missing values per column:\")",
    "missing = df.isna().sum()",
    "print(missing[missing > 0] if missing.sum() > 0 else \"None \u2014 0 missing values across all columns.\")",
    "print()",
    "print(\"Fully duplicated rows:\", df.duplicated().sum())",
    "print(\"Duplicated order_id values:\", df['order_id'].duplicated().sum())",
    ""
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [
    {
     "output_type": "stream",
     "name": "stdout",
     "text": [
      "price <= 0                                   : 0\n",
      "quantity <= 0                                : 0\n",
      "discount < 0 or > 1                          : 0\n",
      "total_amount <= 0                            : 0\n",
      "shipping_cost < 0                            : 0\n",
      "customer_age < 10 or > 100                   : 0\n",
      "delivery_time_days < 0                       : 0\n",
      "order_date outside dataset window            : 0\n"
     ]
    }
   ],
   "source": [
    "# Range / validity checks",
    "checks = {",
    "    'price <= 0': (df['price'] <= 0).sum(),",
    "    'quantity <= 0': (df['quantity'] <= 0).sum(),",
    "    'discount < 0 or > 1': ((df['discount'] < 0) | (df['discount'] > 1)).sum(),",
    "    'total_amount <= 0': (df['total_amount'] <= 0).sum(),",
    "    'shipping_cost < 0': (df['shipping_cost'] < 0).sum(),",
    "    'customer_age < 10 or > 100': ((df['customer_age'] < 10) | (df['customer_age'] > 100)).sum(),",
    "    'delivery_time_days < 0': (df['delivery_time_days'] < 0).sum(),",
    "    'order_date outside dataset window': ((df['order_date'] < '2023-01-01') | (df['order_date'] > '2025-12-31')).sum(),",
    "}",
    "for k, v in checks.items():",
    "    print(f\"{k:45s}: {v}\")",
    ""
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [
    {
     "output_type": "stream",
     "name": "stdout",
     "text": [
      "Exact match:        34,473 (99.92%)\n",
      "Off by exactly 1c:  27 (0.08%)  <- half-cent rounding ties, consistent with Phase 1 finding\n",
      "Off by >1c (real mismatch): 0\n"
     ]
    }
   ],
   "source": [
    "# Recompute total_amount from price/discount/quantity and compare (tolerance for rounding)",
    "expected_total = (df['price'] * (1 - df['discount']) * df['quantity']).round(2)",
    "diff = (df['total_amount'] - expected_total).round(2)",
    "exact = (diff == 0).sum()",
    "one_cent = (diff.abs() == 0.01).sum()",
    "other = (diff.abs() > 0.01).sum()",
    "print(f\"Exact match:        {exact:,} ({exact/len(df):.2%})\")",
    "print(f\"Off by exactly 1c:  {one_cent:,} ({one_cent/len(df):.2%})  <- half-cent rounding ties, consistent with Phase 1 finding\")",
    "print(f\"Off by >1c (real mismatch): {other:,}\")",
    ""
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [
    {
     "output_type": "stream",
     "name": "stdout",
     "text": [
      "Repeat customer_ids: 7,428 of 7,903 unique IDs\n",
      "  -> conflicting age:    99.8%\n",
      "  -> conflicting region: 96.2%\n",
      "  -> conflicting gender: 86.0%\n",
      "Repeat product_ids: 7,576 of 24,912 unique IDs\n",
      "  -> conflicting category: 87.9%\n",
      "\n",
      "CONFIRMED: customer_id/product_id are not stable entity keys. Treated as row labels below.\n"
     ]
    }
   ],
   "source": [
    "# customer_id / product_id key-stability check, done fresh from raw data",
    "cust_orders = df.groupby('customer_id').size()",
    "repeat_cust = cust_orders[cust_orders > 1].index",
    "rc = df[df['customer_id'].isin(repeat_cust)]",
    "age_conflict = rc.groupby('customer_id')['customer_age'].nunique().gt(1).mean()",
    "region_conflict = rc.groupby('customer_id')['region'].nunique().gt(1).mean()",
    "gender_conflict = rc.groupby('customer_id')['customer_gender'].nunique().gt(1).mean()",
    "",
    "prod_orders = df.groupby('product_id').size()",
    "repeat_prod = prod_orders[prod_orders > 1].index",
    "rp = df[df['product_id'].isin(repeat_prod)]",
    "cat_conflict = rp.groupby('product_id')['category'].nunique().gt(1).mean()",
    "",
    "print(f\"Repeat customer_ids: {len(repeat_cust):,} of {df['customer_id'].nunique():,} unique IDs\")",
    "print(f\"  -> conflicting age:    {age_conflict:.1%}\")",
    "print(f\"  -> conflicting region: {region_conflict:.1%}\")",
    "print(f\"  -> conflicting gender: {gender_conflict:.1%}\")",
    "print(f\"Repeat product_ids: {len(repeat_prod):,} of {df['product_id'].nunique():,} unique IDs\")",
    "print(f\"  -> conflicting category: {cat_conflict:.1%}\")",
    "print()",
    "print(\"CONFIRMED: customer_id/product_id are not stable entity keys. Treated as row labels below.\")",
    ""
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [
    {
     "output_type": "stream",
     "name": "stdout",
     "text": [
      "Added: profit_margin_pct, order_month, order_year, order_dow\n"
     ]
    }
   ],
   "source": [
    "# Add derived column used throughout this notebook (currency profit_margin -> real percentage)",
    "df['profit_margin_pct'] = (df['profit_margin'] / df['total_amount'] * 100)",
    "df['order_month'] = df['order_date'].dt.to_period('M').astype(str)",
    "df['order_year'] = df['order_date'].dt.year",
    "df['order_dow'] = df['order_date'].dt.day_name()",
    "print(\"Added: profit_margin_pct, order_month, order_year, order_dow\")",
    ""
   ]
