    "## 10. Outlier Analysis"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [
    {
     "output_type": "stream",
     "name": "stdout",
     "text": [
      "total_amount IQR fence: [-203.52, 391.76]\n",
      "Outlier orders (IQR method): 3,792 (10.99%)\n",
      "Revenue share of these outlier orders: 57.33%\n"
     ]
    }
   ],
   "source": [
    "def iqr_flags(s):",
    "    q1, q3 = s.quantile(.25), s.quantile(.75)",
    "    iqr = q3 - q1",
    "    lo, hi = q1 - 1.5*iqr, q3 + 1.5*iqr",
    "    return (s < lo) | (s > hi), lo, hi",
    "",
    "flag, lo, hi = iqr_flags(df['total_amount'])",
    "print(f\"total_amount IQR fence: [{lo:.2f}, {hi:.2f}]\")",
    "print(f\"Outlier orders (IQR method): {flag.sum():,} ({flag.mean():.2%})\")",
    "print(f\"Revenue share of these outlier orders: {df.loc[flag,'total_amount'].sum() / df['total_amount'].sum():.2%}\")",
    ""
   ]
